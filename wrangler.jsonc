{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Keep this minimal for Cloudflare Pages Git deploys — do not set `name` or
	// `pages_build_output_dir` here (dashboard / adapter owns those). Only
	// runtime compatibility flags for SvelteKit on Workers.
	"compatibility_date": "2024-11-12",
	"compatibility_flags": ["nodejs_compat", "nodejs_als"]
}
